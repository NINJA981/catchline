{
  "name": "catchline",
  "version": "0.1.0",
  "private": true,
  "description": "Pulls the fine print up to the claim it qualifies: matches every *, †, ‡ and ¹ on a page to its footnote and shows the conditions next to the promise.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wxt build && pnpm --dir site build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "check:network": "node scripts/check-network.mjs",
    "check:size": "node scripts/check-size.mjs",
    "engine": "node scripts/run-engine.mjs",
    "postinstall": "wxt prepare",
    "build:site": "pnpm --dir site build",
    "test:site": "pnpm --dir site typecheck && pnpm --dir site test",
    "test:site:e2e": "pnpm --dir site test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:site && pnpm build && pnpm build:firefox && pnpm check:network && pnpm check:size && pnpm build:site && pnpm --dir site check:budget && pnpm --dir site check:network && playwright test && pnpm --dir site exec playwright test"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/commit-mono": "5.3.0",
    "lucide-react": "1.62.0",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}
